# Copy this file to .env and fill in values for local development.
# NEVER commit .env to source control. Use environment variables in production.

# Google / Gemini API keys
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Firebase / Firestore (if you use Firebase features)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# OAuth client credentials (downloaded credentials.json can remain for local dev,
# but you should set these in env for CI/containers)
CLIENT_ID=680091807004-m7l2ntj3i1d8a3bhbr2mdmies3de03pe.apps.googleusercontent.com
CLIENT_SECRET=

# Session secret for express-session (set to a secure random value)
SESSION_SECRET=change-me-in-production

# Optional: override the redirect URI if using a tool like ngrok
OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Google Calendar API (REQUIRED)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_PROJECT_ID=your_project_id_here
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# OpenAI API (if using OpenAI stack)
# ============================================
OPENAI_API_KEY=sk-your_openai_api_key_here

# ============================================
# Google AI (Gemini) - RECOMMENDED
# Get key from: https://makersuite.google.com/app/apikey
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Google Cloud Platform (for Speech Services)
# ============================================
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# ============================================
# Firebase Configuration
# Get from: Firebase Console > Project Settings > General
# ============================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ============================================
# Picovoice (Wake Word Detection)
# Get key from: https://console.picovoice.ai/
# ============================================
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
# Server port (default: 3000)
PORT=3000
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Enable Google Secret Manager (optional, recommended for production)
USE_SECRET_MANAGER=false

# Production URL (REQUIRED for production)
# Set this to your production domain (e.g., https://yourdomain.com)
PRODUCTION_URL=https://yourdomain.com

# ============================================
# Security Configuration
# ============================================
# Session Secret (CRITICAL - REQUIRED for production)
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use the default value in production!
SESSION_SECRET=change-me-to-a-secure-random-value-at-least-32-characters-long

# Firebase Service Account (REQUIRED for production)
# Path to Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/firebase-service-account.json

# Legacy Security Keys (if needed)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
JWT_SECRET=your_jwt_secret_here

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
